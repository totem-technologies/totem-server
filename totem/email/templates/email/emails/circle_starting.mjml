{% extends 'email/emails/_button.mjml' %}
{% block message %}
<mj-text>
  <a class="link-nostyle" href="{{event_link}}">{{event_title}}</a> is starting soon at <strong>{{start}}</strong>.
  Use the link below to join the session. This link expires <strong>5 minutes</strong> after the session starts.
</mj-text>
{% endblock message %}

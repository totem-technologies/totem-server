{% extends 'email/emails/_button.mjml' %}
{% block message %}
<mj-text>
  Your Space is starting tomorrow at <strong>{{start}}</strong>!
</mj-text>
<mj-spacer height="12px"></mj-spacer>
<mj-text>
  Use the link below to add this session to your calendar.
</mj-text>
<mj-spacer height="12px"></mj-spacer>
<mj-text>
    <strong>Can't make it?</strong> Please <a href="{{link}}">cancel your attendance</a> so others can join. Remember, it is not possible to join this session if you are more than 5 minutes late.
</mj-text>

{% endblock message %}

{
  "name": "theme",
  "version": "3.5.0",
  "description": "",
  "type": "module",
  "scripts": {
    "build:atcb": "bun build node_modules/add-to-calendar-button/dist/atcb-no-pro.js --drop=console --minify --outfile=totem/static/js/bundles/atcb.min.js && perl -pi -e s,add-to-calendar-pro.com,totem.org,g totem/static/js/bundles/atcb.min.js",
    "build": "vite build && bun run build:atcb",
    "dev": "vite build --watch --mode development",
    "livereload": "livereload ./totem/ -e 'html,css,js,mjml' --wait 200",
    "openapi-ts": "openapi-ts",
    "typecheck": "bunx @typescript/native-preview --noEmit --skipLibCheck",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt assets global.d.ts *.config.ts",
    "format:check": "oxfmt --check assets global.d.ts *.config.ts",
    "test": "vitest",
    "test:ci": "bun run typecheck && bun run lint && vitest run"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "engines": {
    "bun": "1.3.x"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.99.0",
    "@solidjs/testing-library": "^0.8.10",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/bun": "^1.4.0",
    "@types/js-cookie": "^3.0.6",
    "daisyui": "^5.7.27",
    "eslint-plugin-solid": "^0.17.0",
    "jsdom": "^29.1.1",
    "livereload": "^0.10.3",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.6",
    "prettier-plugin-jinja-template": "^2.2.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@leeoniya/ufuzzy": "^1.0.19",
    "@rnwonder/solid-date-picker": "^1.5.0",
    "@solid-primitives/intersection-observer": "^2.2.5",
    "@solid-primitives/keyboard": "^1.3.7",
    "@solid-primitives/media": "^2.3.6",
    "@solid-primitives/refs": "^1.1.4",
    "@tanstack/solid-query": "^5.102.8",
    "@totem.org/solid-boring-avatars": "^0.0.2",
    "@zootools/email-spell-checker": "^1.12.0",
    "add-to-calendar-button": "^2.15.0",
    "js-cookie": "^3.0.8",
    "solid-element": "^1.9.2",
    "solid-icons": "^1.2.0",
    "solid-js": "^1.9.15",
    "tippy.js": "^6.3.7"
  }
}
